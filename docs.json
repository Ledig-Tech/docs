{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ledig",
  "description": "Developer documentation for Ledig's liquidity, settlement and wallet APIs.",
  "colors": {
    "primary": "#4361EE",
    "light": "#4361EE",
    "dark": "#8DA1FF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "introduction",
              "quickstart",
              "auth/authentication",
              "errors/errors-and-troubleshooting"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "guides/balances",
              "guides/funding",
              "guides/recipients",
              "guides/quotes",
              "guides/transfers",
              "guides/transactions"
            ]
          },
          {
            "group": "Conventions",
            "pages": [
              "guides/pagination",
              "guides/idempotency"
            ]
          },
          {
            "group": "Events",
            "pages": [
              "hooks/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi/public.yaml",
        "pages": [
          "api-reference/introduction",
          "GET /v1/health",
          "GET /v1/currencies",
          "GET /v1/rates",
          "GET /v1/balances",
          "GET /v1/balances/{currency}",
          "POST /v1/wallets",
          "GET /v1/wallets",
          "GET /v1/wallets/{id}",
          "GET /v1/virtual-accounts/{currency}",
          "POST /v1/recipients",
          "GET /v1/recipients",
          "GET /v1/recipients/{id}",
          "DELETE /v1/recipients/{id}",
          "GET /v1/quotes/payment-options",
          "POST /v1/quotes",
          "GET /v1/quotes",
          "GET /v1/quotes/{id}",
          "POST /v1/transfers",
          "GET /v1/transfers/{id}",
          "GET /v1/transactions",
          "GET /v1/transactions/{id}"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:admin@ledig.io"
      },
      {
        "label": "Website",
        "href": "https://www.ledig.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Request access",
      "href": "https://www.ledig.io/contact"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/endpoints/endpoints-guide",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/base-urls",
      "destination": "/introduction"
    },
    {
      "source": "/api-reference/authentication",
      "destination": "/auth/authentication"
    },
    {
      "source": "/api-reference/utility",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/rates-and-instant-liquidity",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/crypto-wallets",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/fiat-wallets",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/settlement",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/api-reference/sandbox-testing",
      "destination": "/introduction"
    },
    {
      "source": "/api-reference/models",
      "destination": "/api-reference/introduction"
    }
  ]
}
