{
  "name": "ledig-client-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "mint dev --client-version 0.0.4114",
    "check:content": "node scripts/check-docs.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "check:mint": "mint validate --client-version 0.0.4114",
    "check:links": "mint broken-links",
    "check": "npm run check:content && npm test && npm run check:mint && npm run check:links"
  },
  "devDependencies": {
    "mint": "4.3.19",
    "yaml": "2.9.1"
  }
}
